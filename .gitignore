# logs
npm-debug.log*
yarn-debug.log*
bun-debug.log*
*.log

# editor
.vscode/*
!.vscode/settings.json
.idea
.DS_Store

# Claude Code: personal/machine-local config. settings.local.json is per-user;
# launch.json is the local preview recipe (coupled to `railway run`). Shared
# .claude/ config (e.g. settings.json, skills) can still be committed explicitly.
.claude/settings.local.json
.claude/launch.json

# Machine-local Codex MCP credentials. Never commit plaintext API keys.
.codex/config.toml

# tests
coverage
.vitest
tsconfig.tsbuildinfo

# Playwright end-to-end artifacts (reports and traces).
/playwright-report/
/test-results/

# stray TanStack routeTree artifact generated at the wrong path during build;
# the real one lives at src/routes/routeTree.gen.ts.
/src/routeTree.gen.ts

# Real Linear backups contain member PII and must never be committed. Only the
# schema-only reference (reference/linear/schema.sql) belongs in git.
/reference/linear/datesicherung.sql
/reference/linear/*.dump
/reference/linear/*.backup

# Mandanten-Dumps (scripts/backup.ts) enthalten PII -- niemals committen.
/backups/
