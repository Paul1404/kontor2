# --- App ---
NODE_ENV=development
PORT=3000
BETTER_AUTH_URL=http://localhost:3000

# Master secret. All cryptographic subkeys (better-auth signing, data-at-rest
# encryption, SVUMS push HMAC) are derived from this via HKDF-SHA256.
# Generate with: `openssl rand -hex 32` (64 hex chars, 32 bytes)
APP_SECRET=replace-me-32-bytes-hex

# One-time capability for claiming the first admin on a completely fresh
# production installation. Generate at least 32 random characters, use it once
# on /setup, then remove it after the first admin exists. Tenants created later
# receive their own generated setup code from the operator console.
# SETUP_BOOTSTRAP_TOKEN=

# Previous APP_SECRET(s), comma-separated, for safe rotation. While set, the
# data-encryption keyring accepts ciphertexts written under the old key(s),
# so existing IBANs etc. stay readable. After running the admin "Re-encrypt
# data" action (Einstellungen > Verschlüsselung), drop this variable.
# Rotation steps:
#   1. Set APP_SECRET_PREV to the current APP_SECRET
#   2. Generate a new APP_SECRET and deploy
#   3. Run Einstellungen > Verschlüsselung > Re-encrypt
#   4. Unset APP_SECRET_PREV and redeploy
# The SVUMS push HMAC is also derived from APP_SECRET; update the SVUMS side
# with the new secret (see `bun scripts/print-derived-secrets.ts`).
# APP_SECRET_PREV=

# --- Postgres (Railway: ${{Postgres.DATABASE_URL}}) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/svuwv

# --- Redis (Railway: ${{Redis.REDIS_URL}}) ---
REDIS_URL=redis://localhost:6379

# --- S3 / Bucket (Railway: ${{Bucket.*}}) ---
AWS_ENDPOINT_URL=https://s3.amazonaws.com
AWS_S3_BUCKET_NAME=svuwv-attachments
AWS_DEFAULT_REGION=eu-central-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# How long the server waits for in-flight requests to finish on shutdown
# (SIGTERM/SIGINT) before forcing connections closed. Milliseconds, optional,
# defaults to 15000. Keep it below the platform's hard-kill grace period.
# SHUTDOWN_TIMEOUT_MS=15000

# --- Observability ---
# Minimum log level for the console: info | warn | error. Defaults to info. Set
# to warn in production to drop the per-request rpc.ok lines from stdout and
# keep only warnings/errors.
# LOG_LEVEL=info

# The application log is also mirrored into Postgres so it can be read in-app
# under Verwaltung > Systemprotokoll (admin only). These tune that sink; all
# are optional with sensible defaults.
#   LOG_DB_DISABLED=1  turn the database mirror off entirely
#   LOG_DB_LEVEL       floor for what gets persisted: info | warn | error (info)
#   LOG_DB_RETENTION_DAYS  delete entries older than this many days (14)
#   LOG_DB_MAX_ROWS    hard cap on stored rows; oldest beyond it are trimmed (100000)
# LOG_DB_DISABLED=0
# LOG_DB_LEVEL=info
# LOG_DB_RETENTION_DAYS=14
# LOG_DB_MAX_ROWS=100000

# --- Security ---
# Override the Content-Security-Policy sent on HTML documents. Leave unset to
# use the built-in default; set empty to disable CSP entirely.
# CONTENT_SECURITY_POLICY=
