{
  "name": "svuwv",
  "version": "0.76.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Paul Dresch <paul.dresch@untereuerheim.com>",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "bun scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "bun scripts/test-db.ts run vitest run --config vitest.integration.config.ts",
    "test:db:up": "bun scripts/test-db.ts up",
    "test:db:migrate": "bun scripts/test-db.ts migrate",
    "test:db:down": "bun scripts/test-db.ts down",
    "verify": "bun run typecheck && biome ci . && bun run test && bun run build",
    "routes:regen": "bun scripts/regen-routes.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "bun scripts/migrate.prod.ts",
    "db:backfill:geschlecht": "bun scripts/backfill-geschlecht.ts",
    "db:seed:antraege": "bun scripts/seed-antraege.ts",
    "db:studio": "drizzle-kit studio",
    "icons:generate": "bun scripts/generate-icons.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/s3-request-presigner": "^3.1065.0",
    "@better-auth/api-key": "1.6.16",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@orpc/client": "^1.14.5",
    "@orpc/openapi": "^1.14.5",
    "@orpc/server": "^1.14.5",
    "@orpc/tanstack-query": "^1.14.5",
    "@react-pdf/renderer": "4.5.1",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-start": "^1.168.25",
    "@tanstack/react-store": "^0.11.0",
    "@valibot/to-json-schema": "^1.7.1",
    "better-auth": "^1.6.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-valibot": "^0.4.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.17.0",
    "nodemailer": "^8.0.10",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "sharp": "^0.34.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-env-only": "^3.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.0.0"
  }
}
