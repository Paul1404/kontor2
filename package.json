{
  "name": "kontor2",
  "version": "5.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Paul Dresch <paul.dresch@untereuerheim.com>",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts vite",
    "build": "vite build",
    "start": "bun --smol scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.browser.config.ts",
    "test:watch": "vitest",
    "test:int": "bun scripts/test-db.ts run vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright install chromium && bun scripts/test-db.ts run playwright test",
    "test:e2e:ui": "bun scripts/test-db.ts run playwright test --ui",
    "sandbox": "bun scripts/sandbox.ts",
    "sandbox:down": "docker compose -f docker-compose.test.yml down -v --remove-orphans",
    "test:db:up": "bun scripts/test-db.ts up",
    "test:db:migrate": "bun scripts/test-db.ts migrate",
    "test:db:down": "bun scripts/test-db.ts down",
    "dev:up": "bun scripts/dev.ts up",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "dev:reset": "bun scripts/dev.ts reset",
    "dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:serve": "bun scripts/dev.ts serve",
    "verify": "bun run typecheck && biome ci . && bun run test && bun run build",
    "routes:regen": "bun scripts/regen-routes.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "bun scripts/migrate-all.ts",
    "db:migrate:status": "bun scripts/migrate-status.ts",
    "db:backup": "bun scripts/backup.ts",
    "db:restore": "bun scripts/restore.ts",
    "db:reencrypt": "bun scripts/reencrypt.ts",
    "db:backfill:geschlecht": "bun scripts/backfill-geschlecht.ts",
    "db:seed:antraege": "bun scripts/seed-antraege.ts",
    "db:studio": "drizzle-kit studio",
    "icons:generate": "bun scripts/generate-brand-icons.ts",
    "icons:brand": "bun scripts/generate-brand-icons.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@better-auth/api-key": "1.7.12",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@orpc/client": "^1.16.1",
    "@orpc/openapi": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@orpc/tanstack-query": "^1.16.1",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@valibot/to-json-schema": "^1.8.0",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-valibot": "^0.4.2",
    "exceljs": "^4.4.0",
    "imapflow": "^2.9.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.2.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/mailparser": "3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-env-only": "^3.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils>esbuild": "0.28.2",
    "exceljs>uuid": "11.1.1"
  }
}
